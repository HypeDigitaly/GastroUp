# Resend API key (REQUIRED) — get a DEDICATED key from resend.com/api-keys
# Scope: "Sending access" for domain notifications.gastroup.cz (must be verified in Resend first — SPF/DKIM/DMARC DNS records)
# NOTE: Runtime-only — set in Netlify UI under Site settings > Environment variables (scope: Functions only)
RESEND_API_KEY=

# Where to send team notifications (REQUIRED)
# NOTE: Runtime-only — set in Netlify UI under Site settings > Environment variables (scope: Functions only)
NOTIFICATION_TO=jakub.hnat@gastroup.cz

# From address used in all outgoing emails (REQUIRED)
# NOTE: Runtime-only — set in Netlify UI under Site settings > Environment variables (scope: Functions only)
FROM_EMAIL=GastroUp <noreply@notifications.gastroup.cz>

# Public URL of the ebook PDF (REQUIRED before production — dummy during dev)
# NOTE: Runtime-only — set in Netlify UI under Site settings > Environment variables (scope: Functions only)
EBOOK_PDF_URL=https://gastroup.cz/ebook/28-nametu.pdf

# Public URL of the ebook cover image shown in the delivery email
# NOTE: Runtime-only — set in Netlify UI under Site settings > Environment variables (scope: Functions only)
EBOOK_COVER_URL=https://gastroup.cz/Ebook_Image.jpeg

# CTA button URL (FAPI start tariff form) (REQUIRED)
# NOTE: Runtime-only — set in Netlify UI under Site settings > Environment variables (scope: Functions only)
CTA_URL=https://form.fapi.cz/?id=4a82141f-d02b-489d-93b0-66f81a8cec6a

# Allowed origin for CORS (REQUIRED) — set to https://gastroup.cz before production launch
# NOTE: Runtime-only — set in Netlify UI under Site settings > Environment variables (scope: Functions only)
ALLOWED_ORIGIN=*
